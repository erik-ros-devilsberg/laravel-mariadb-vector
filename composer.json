{
    "name": "devilsberg/laravel-mariadb-vector",
    "description": "MariaDB 11.7+ native vector storage and search for Laravel Eloquent models",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Erik Ros",
            "email": "erik.ros@devilsberg.com"
        }
    ],
    "keywords": [
        "laravel",
        "mariadb",
        "vector",
        "vector-search",
        "embeddings",
        "similarity-search",
        "eloquent",
        "database"
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Devilsberg\\LaravelMariadbVector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devilsberg\\LaravelMariadbVector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devilsberg\\LaravelMariadbVector\\VectorServiceProvider"
            ]
        }
    },
    "source": {
        "type": "git",
        "url": "https://github.com/erik-ros-devilsberg/laravel-mariadb-vector",
        "reference": "main"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
